%%  SPDX-License-Identifier: MIT
%%  Permission is hereby granted, free of charge, to any person obtaining a
%%  copy of this file, to deal in it without restriction, including the
%%  rights to use, copy, modify, merge, publish, distribute, sublicense and/or
%%  sell copies, subject to inclusion of this notice. THE FILE IS PROVIDED
%%  "AS IS", WITHOUT WARRANTY OF ANY KIND (full text: opensource.org/license/mit).
%%
%%  Purpose
%%  -------
%%  Draws HPB diagrams (product lines, baselines, typed branches, merges,
%%  discards, line forks, gates) with one fixed visual vocabulary, so that
%%  every practitioner renders HPB the same way. Works with pdfLaTeX,
%%  XeLaTeX and LuaLaTeX; no shell escape, no external files.
%%
%%  Coordinate system
%%  -----------------
%%  Inside the environment  hpbgraph  the TikZ unit vectors are
%%      x = 1 column  (key  col,  default 1.1cm)  -- ordinal time
%%      y = 1 lane    (key  lane, default 1.0cm)  -- 0 = main line,
%%                                                   +1,+2 above, -1,-2 below
%%  (version tags are anchored 5.5pt above their node, so the tag arrow has
%%  the same length for every node shape; lane = 1.0cm is the smallest value
%%  that keeps a tag clear of a branch running on lane +1),
%%  so every macro takes plain numbers  (col,lane)  and every position in a
%%  diagram is derived from the two keys  col  and  lane.  Glyph sizes are
%%  fixed (in pt) by the HPB notation standard so that symbols look the same
%%  in every figure; only spacing scales.
%%
%%  Layers (bottom to top, six in total):  background (gate and bundle bands)
%%  < hpbguide (lane guides, NOW, leaders) < hpbbranch (branch paths and
%%  connectors) < hpbline (main lines, streams, line forks) < main (nodes)
%%  < hpbfront (tags, labels, badges, callout boxes).
%%  All macros must therefore be used inside  \begin{hpbgraph} ... \end{hpbgraph}.
%%
%%  The full user documentation (every macro, its arguments and examples)
%%  is in the paper's Appendix B and in hpb-api.md.  Public interface summary:
%%
%%   \hpbset{<keys>}                                    global defaults
%%   \begin{hpbgraph}[col=..,lane=..,legend=..,<tikz>]  the canvas
%%   \hpblane{<lane>}{<type>}{<label>}{<from>}{<to>}    lane guide + legend box
%%   \hpbmainline[*]{<from>}{<to>}[<y>]                 main line (* = planned, dashed)
%%   \hpborigin{<col>}{<label>}[<y>]                    creation of a reference (not a baseline)
%%   \hpbrelease[<caption>]{<col>}{<name>}[<y>]         released baseline + tag
%%   \hpbplanned[*][<caption>]{<col>}{<name>}{<date>}[<y>]  planned baseline (* = overdue)
%%   \hpbhardware[<caption>]{<col>}{<name>}[<y>]        hardware baseline (diamond)
%%   \hpbprocess[<caption>]{<col>}{<name>}[<y>]         process baseline (square)
%%   \hpbstream[*][<off>]{<forkcol>}{<y>}{<tocol>}[<fromy>]  release stream (maintenance)
%%   \hpbmilestone{<col>}{<label>}[<y>]                 life-cycle milestone tick
%%   \hpbbranch[<keys>]{<type>}{<forkcol>}{<lane>}{<startcol>}{<endcol>}{<end>}{<mergecol>}
%%   \hpbtarget[<keys>]{<fromcol>}{<lane>}{<mergecol>}  extra dashed target (re-targeting)
%%   \hpbstart{<type>}{<col>}{<lane>}{<letter>}         start node with type letter
%%   \hpbnode{<type>}{<col>}{<lane>}                    plain event node
%%   \hpbterminal{<kind>}{<type>}{<col>}{<lane>}        merge / discard / open terminal
%%   \hpbstep{<type>}{<col>}{<lane>}{done|todo|pass|fail}
%%   \hpbpoststep{<type>}{<fromcol>}{<col>}{<lane>}{<state>}  post-closure step
%%   \hpbdepends[<tikz>]{<x,y>}{<x,y>}{<label>}          dependency connector
%%   \hpbpropagates[<tikz>]{<x,y>}{<x,y>}{<label>}       propagation (port) connector
%%   \hpblabel[<pos>]{<col>}{<lane>}{<text>}            branch label with white halo
%%   \hpbnow{<col>}{<lanetop>}{<lanebottom>}            NOW marker
%%   \hpbcollapsed{<col>}{<count>}[<y>]                 count badge (collapsed history)
%%   \hpbeos{<col>}[<y>]                                end-of-support bar
%%   \hpblinefork{<col>}{<fromy>}{<toy>}                line-fork connector
%%   \hpbgate[<right>]{<col>}{<lanetop>}{<lanebottom>}{<label>}  gate band
%%   \hpbbundle{<x1,y1>}{<x2,y2>}{<label>}              launch bundle (cross-line gate)
%%   \hpbseparator{<y>}{<from>}{<to>}                   rule between two product lines
%%   \hpbfit{<picture>}                                 scale down to \linewidth only if wider
%%   \hpbcallout[<tikz>]{<x,y>}{<text>}{<x,y>}          annotation with leader line
%%   (the leader ends without a dot; route it so that it never crosses a
%%   label or a branch other than the one it points to)
%%   \hpbaxis{<from>}{<to>}{<y>}, \hpbtick{<col>}{<text>}{<y>}   ordinal time axis
%% =====================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{hpb}[2026/11/17 v1.1 Horizontal Product Branch (HPB) notation]

\RequirePackage{xparse}% \NewDocumentCommand (built into LaTeX >= 2020-10)
\RequirePackage{xcolor}
\RequirePackage{graphicx}% \resizebox in \hpbfit
\RequirePackage{tikz}
\usetikzlibrary{positioning,calc,shapes.geometric,arrows.meta,%
  decorations.pathmorphing,backgrounds,fit}

%% ---------------------------------------------------------------------
%% 1. Color palette (soft fills, one dark ink).  Names are part of the API.
%% ---------------------------------------------------------------------
\definecolor{hpbInk}{HTML}{374151}   % outlines, paths, text
\definecolor{hpbMain}{HTML}{BAE6FD}  % released baselines, tags
\definecolor{hpbImp}{HTML}{C4B5FD}   % I  improvement (violet)
\definecolor{hpbIss}{HTML}{FB8A6E}   % X  issue / defect (coral)
\definecolor{hpbTask}{HTML}{6EE7B7}  % T  task (green)
\definecolor{hpbLab}{HTML}{5EEAD4}   % L  laboratory evolution (teal)
\definecolor{hpbHw}{HTML}{A5B4FC}    % hardware baseline (indigo)
\definecolor{hpbDisc}{HTML}{E5E7EB}  % discarded fill (gray)
\definecolor{hpbNow}{HTML}{0EA5E9}   % NOW marker (sky)
\definecolor{hpbGuide}{HTML}{D1D5DB} % dotted lane guides
\definecolor{hpbLate}{HTML}{DC2626}  % overdue planned baseline, failed test
% auxiliary tones (also public)
\definecolor{hpbMuted}{HTML}{6B7280} % secondary text, callout leaders
\definecolor{hpbDiscInk}{HTML}{9CA3AF}% discarded path, callout frames
\definecolor{hpbPass}{HTML}{059669}  % passed test step
\definecolor{hpbHwInk}{HTML}{3730A3} % hardware caption text

%% ---------------------------------------------------------------------
%% 2. Branch types: <key> -> color, letter.  Aliases I, X, T, L accepted.
%%    Pseudo-types main, hw and disc are valid for legend boxes and nodes.
%% ---------------------------------------------------------------------
\newcommand\hpb@deftype[3]{%
  \expandafter\def\csname hpb@tcol@#1\endcsname{#2}%
  \expandafter\def\csname hpb@tlet@#1\endcsname{#3}}
\hpb@deftype{imp}{hpbImp}{I}   \hpb@deftype{I}{hpbImp}{I}
\hpb@deftype{iss}{hpbIss}{X}   \hpb@deftype{X}{hpbIss}{X}
\hpb@deftype{task}{hpbTask}{T} \hpb@deftype{T}{hpbTask}{T}
\hpb@deftype{lab}{hpbLab}{L}   \hpb@deftype{L}{hpbLab}{L}
\hpb@deftype{main}{hpbMain}{}  \hpb@deftype{hw}{hpbHw}{}
\hpb@deftype{disc}{hpbDisc}{}
% \hpb@settype{<type>} -> \hpb@tc (color name), \hpb@tl (letter)
\newcommand\hpb@settype[1]{%
  \ifcsname hpb@tcol@#1\endcsname
    \edef\hpb@tc{\csname hpb@tcol@#1\endcsname}%
    \edef\hpb@tl{\csname hpb@tlet@#1\endcsname}%
  \else
    \PackageError{hpb}{Unknown HPB type `#1'}%
      {Valid types: imp, iss, task, lab (or I, X, T, L); main, hw, disc.}%
    \def\hpb@tc{hpbInk}\def\hpb@tl{?}%
  \fi}

%% ---------------------------------------------------------------------
%% 3. Fonts (sans serif, sizes chosen to stay >= 6pt after mild scaling)
%% ---------------------------------------------------------------------
\newcommand\hpb@fs{\sffamily\fontsize{6.5}{7.5}\selectfont}            % small
\newcommand\hpb@fsb{\sffamily\bfseries\fontsize{6.5}{7.5}\selectfont}  % small bold
\newcommand\hpb@fm{\sffamily\fontsize{7}{8.4}\selectfont}              % medium
\newcommand\hpb@fmb{\sffamily\bfseries\fontsize{7}{8.4}\selectfont}    % medium bold

%% ---------------------------------------------------------------------
%% 4. Keys: geometry of the canvas
%% ---------------------------------------------------------------------
\newlength\hpb@colL   \setlength\hpb@colL{1.1cm}   % one ordinal column
\newlength\hpb@laneL  \setlength\hpb@laneL{1.0cm}  % one lane
\newlength\hpb@legendL\setlength\hpb@legendL{2.3cm}% legend / origin box width
\def\hpb@extra{}                                   % extra TikZ options
\def\hpb@novalue{\pgfkeysnovalue}
\long\def\hpb@addextra#1#2{% collect unknown keys and pass them to TikZ
  \def\hpb@tmp{#2}%
  \ifx\hpb@tmp\hpb@novalue
    \expandafter\def\expandafter\hpb@extra\expandafter{\hpb@extra#1,}%
  \else
    \expandafter\def\expandafter\hpb@extra\expandafter{\hpb@extra#1={#2},}%
  \fi}
\pgfkeys{/hpb/graph/.is family, /hpb/graph,
  col/.code    = {\setlength\hpb@colL{#1}},
  lane/.code   = {\setlength\hpb@laneL{#1}},
  legend/.code = {\setlength\hpb@legendL{#1}},
  .unknown/.code = {\expandafter\hpb@addextra\expandafter{\pgfkeyscurrentname}{#1}},
}
\newcommand\hpbset[1]{\pgfqkeys{/hpb/graph}{#1}}

%% Gap between the top of a baseline node and the bottom of its tag (fixed, so
%% that the tag arrow has the same length for every node shape and lane value)
\newcommand\hpb@taggap{5.5pt}

%% ---------------------------------------------------------------------
%% 5. Layers and the hpbgraph environment
%% ---------------------------------------------------------------------
\pgfdeclarelayer{background}
\pgfdeclarelayer{hpbguide}
\pgfdeclarelayer{hpbbranch}
\pgfdeclarelayer{hpbline}
\pgfdeclarelayer{hpbfront}
\newenvironment{hpbgraph}[1][]{%
  \pgfqkeys{/hpb/graph}{#1}%
  \edef\hpb@opts{x=\the\hpb@colL,y=\the\hpb@laneL,%
    \unexpanded\expandafter{\hpb@extra}}%
  \expandafter\tikzpicture\expandafter[\hpb@opts]%
  \pgfsetlayers{background,hpbguide,hpbbranch,hpbline,main,hpbfront}%
}{\endtikzpicture}

%% ---------------------------------------------------------------------
%% 6. Styles.  Stroke widths: main line 3pt, branch 2pt, node outline 1.6pt,
%%    tag 1pt, legend 0.8pt, leaders 0.6pt.  Corner radius of paths 8pt.
%% ---------------------------------------------------------------------
\tikzset{
  hpb/main line/.style  = {draw=hpbInk, line width=3pt, line cap=butt},
  hpb/plan line/.style  = {line cap=butt, dash pattern=on 6pt off 4pt,
                           dash phase=6pt},% starts with a gap at NOW
  hpb/stream/.style     = {draw=hpbInk, line width=3pt, line cap=butt,
                           rounded corners=8pt},
  hpb/guide/.style      = {draw=hpbGuide, line width=1.5pt, line cap=round,
                           dash pattern=on 0pt off 4.5pt},
  hpb/path/.style       = {draw=hpbInk, line width=2pt, rounded corners=8pt,
                           line cap=round, line join=round},
  hpb/path discard/.style = {draw=hpbDiscInk},
  hpb/path target/.style  = {line width=1.6pt, line cap=butt,
                             dash pattern=on 4pt off 3pt},
  hpb/event/.style      = {circle, minimum size=14pt, inner sep=0pt,
                           draw=hpbInk, line width=1.6pt, font=\hpb@fmb,
                           text=hpbInk},
  hpb/step/.style       = {circle, minimum size=8pt, inner sep=0pt,
                           draw=hpbInk, line width=1.2pt},
  hpb/head ring/.style  = {circle, minimum size=21pt, inner sep=0pt,
                           line width=1.6pt},
  hpb/baseline/.style   = {circle, minimum size=18pt, inner sep=0pt,
                           fill=hpbMain, draw=hpbInk, line width=1.6pt},
  hpb/planned/.style    = {circle, minimum size=18pt, inner sep=0pt,
                           fill=white, draw=hpbInk, line width=1.4pt,
                           dash pattern=on 2.6pt off 1.8pt},
  hpb/hardware/.style   = {diamond, minimum size=22pt, inner sep=0pt,
                           aspect=1, fill=hpbHw, draw=hpbInk, line width=1.6pt},
  hpb/origin/.style     = {circle, minimum size=9pt, inner sep=0pt, fill=hpbInk},
  hpb/process/.style    = {rectangle, minimum size=15pt, inner sep=0pt,
                           fill=hpbMain, draw=hpbInk, line width=1.6pt},
  hpb/overdue/.style    = {circle, fill=hpbLate, text=white, font=\hpb@fsb,
                           minimum size=9pt, inner sep=0pt},
  hpb/tag/.style        = {rectangle, draw=hpbInk, line width=1pt, fill=hpbMain,
                           inner xsep=2pt, inner ysep=1.7pt,
                           text height=4.9pt, text depth=0.6pt,
                           font=\hpb@fsb, text=hpbInk},
  hpb/tag planned/.style= {fill=white, dash pattern=on 2pt off 1.4pt},
  hpb/tag late/.style   = {draw=hpbLate, line width=1.2pt},
  hpb/tag arrow/.style  = {draw=hpbInk, line width=0.9pt,
                           -{Stealth[length=3.2pt,width=3.6pt]},
                           shorten >=0.9pt},
  hpb/legend/.style     = {rectangle, rounded corners=2pt, draw=hpbInk,
                           line width=0.8pt, font=\hpb@fmb, text=hpbInk,
                           minimum width=\hpb@legendL, minimum height=12pt,
                           inner xsep=3pt, inner ysep=1.5pt, align=center},
  hpb/label/.style      = {font=\hpb@fs, text=hpbInk, fill=white,
                           fill opacity=0.85, text opacity=1, inner sep=1pt,
                           rounded corners=1pt, align=left},
  hpb/label above/.style       = {anchor=south west, xshift=-4pt, yshift=8.5pt},
  hpb/label below/.style       = {anchor=north west, xshift=-4pt, yshift=-8.5pt},
  hpb/label right/.style       = {anchor=west, xshift=10pt},
  hpb/label left/.style        = {anchor=east, xshift=-10pt},
  hpb/label above left/.style  = {anchor=south east, xshift=4pt, yshift=8.5pt},
  hpb/label below left/.style  = {anchor=north east, xshift=4pt, yshift=-8.5pt},
  hpb/label above center/.style= {anchor=south, yshift=8.5pt},
  hpb/label below center/.style= {anchor=north, yshift=-8.5pt},
  hpb/date/.style       = {font=\hpb@fs\itshape, text=hpbMuted, inner sep=1pt,
                           fill=white, fill opacity=0.85, text opacity=1},
  hpb/badge/.style      = {circle, fill=hpbInk, text=white, font=\hpb@fsb,
                           minimum size=10.5pt, inner sep=0.3pt},

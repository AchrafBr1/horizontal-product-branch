{
  "name": "@hpb/cli",
  "version": "1.0.0",
  "description": "Command-line tool for HPB Markup: render Horizontal Product Branch diagrams to SVG and validate .hpb files.",
  "license": "MIT",
  "author": "Achraf Bouchtarouif El Khiat <achrafbouchtarouif@gmail.com>",
  "homepage": "https://github.com/AchrafBr1/horizontal-product-branch/tree/main/packages/cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AchrafBr1/horizontal-product-branch.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/AchrafBr1/horizontal-product-branch/issues"
  },
  "keywords": [
    "hpb",
    "horizontal-product-branch",
    "diagram",
    "svg",
    "cli",
    "text-to-diagram"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/cli.js"
  ],
  "bin": {
    "hpb": "./dist/cli.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hpb/core": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "20.17.10",
    "tsup": "8.3.5",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  },
  "publishConfig": {
    "access": "public"
  }
}

{
  "name": "@hpb/react",
  "version": "1.0.0",
  "description": "React component for HPB Markup: render Horizontal Product Branch diagrams from text. SSR-safe, works with Next.js (App Router) and Vite.",
  "license": "MIT",
  "author": "Achraf Bouchtarouif El Khiat <achrafbouchtarouif@gmail.com>",
  "homepage": "https://github.com/AchrafBr1/hpb/tree/main/packages/react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AchrafBr1/hpb.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/AchrafBr1/hpb/issues"
  },
  "keywords": [
    "hpb",
    "horizontal-product-branch",
    "react",
    "nextjs",
    "diagram",
    "svg",
    "product-management",
    "roadmap"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "require": {
        "types": "./dist/server.d.cts",
        "default": "./dist/server.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "server": [
        "./dist/server.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hpb/core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.1.0",
    "@types/node": "20.17.10",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "axe-core": "4.10.2",
    "jsdom": "25.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsup": "8.3.5",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}

{
  "name": "@hpb/core",
  "version": "1.0.0",
  "description": "HPB Markup core: parser, HPB rule checks (R1-R4, and R5-R7 where the text allows), ordinal layout and pure-string SVG renderer for Horizontal Product Branch diagrams. Zero runtime dependencies.",
  "license": "MIT",
  "author": "Achraf Bouchtarouif El Khiat <achrafbouchtarouif@gmail.com>",
  "homepage": "https://github.com/AchrafBr1/horizontal-product-branch/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AchrafBr1/horizontal-product-branch.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/AchrafBr1/horizontal-product-branch/issues"
  },
  "keywords": [
    "hpb",
    "horizontal-product-branch",
    "diagram",
    "svg",
    "product-management",
    "roadmap",
    "release",
    "text-to-diagram"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.global.js",
  "jsdelivr": "./dist/index.global.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "20.17.10",
    "tsup": "8.3.5",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
